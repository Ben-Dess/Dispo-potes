rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function groupMember(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    function eventMember(eventId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        groupMember(get(/databases/$(database)/documents/events/$(eventId)).data.groupId);
    }
    function eventCreator(eventId) {
      return signedIn() &&
        get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid;
    }
    // Shared 2D avatar presets, no third-party photos or personal data.
    match /profiles/{profileId} {
      allow get: if signedIn();
      allow list, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == profileId
        && request.resource.data.keys().hasOnly(['avatar','updatedAt'])
        && request.resource.data.avatar is map
        && request.resource.data.avatar.keys().hasAll(['skin','hair','shirt','style','eyes'])
        && request.resource.data.avatar.keys().hasOnly(['skin','hair','shirt','style','eyes','accessory','face','brows','nose','mouth','outfit','motion'])
        && request.resource.data.avatar.skin is int
        && request.resource.data.avatar.skin >= 0
        && request.resource.data.avatar.skin < 7
        && request.resource.data.avatar.hair is int
        && request.resource.data.avatar.hair >= 0
        && request.resource.data.avatar.hair < 10
        && request.resource.data.avatar.shirt is int
        && request.resource.data.avatar.shirt >= 0
        && request.resource.data.avatar.shirt < 8
        && request.resource.data.avatar.style is int
        && request.resource.data.avatar.style >= 0
        && request.resource.data.avatar.style < 12
        && request.resource.data.avatar.eyes is int
        && request.resource.data.avatar.eyes >= 0
        && request.resource.data.avatar.eyes < 5
        && (!('accessory' in request.resource.data.avatar)
            || (request.resource.data.avatar.accessory is int
                && request.resource.data.avatar.accessory >= 0
                && request.resource.data.avatar.accessory < 10))
        && (!('face' in request.resource.data.avatar)
            || (request.resource.data.avatar.face is int
                && request.resource.data.avatar.face >= 0
                && request.resource.data.avatar.face < 4))
        && (!('brows' in request.resource.data.avatar)
            || (request.resource.data.avatar.brows is int
                && request.resource.data.avatar.brows >= 0
                && request.resource.data.avatar.brows < 5))
        && (!('nose' in request.resource.data.avatar)
            || (request.resource.data.avatar.nose is int
                && request.resource.data.avatar.nose >= 0
                && request.resource.data.avatar.nose < 4))
        && (!('mouth' in request.resource.data.avatar)
            || (request.resource.data.avatar.mouth is int
                && request.resource.data.avatar.mouth >= 0
                && request.resource.data.avatar.mouth < 6))
        && (!('outfit' in request.resource.data.avatar)
            || (request.resource.data.avatar.outfit is int
                && request.resource.data.avatar.outfit >= 0
                && request.resource.data.avatar.outfit < 6))
        && (!('motion' in request.resource.data.avatar)
            || (request.resource.data.avatar.motion is int
                && request.resource.data.avatar.motion >= 0
                && request.resource.data.avatar.motion < 4));
    }
        match /users/{userId}/groups/{groupId} {
      allow read, delete: if signedIn() && userId == request.auth.uid;
      allow create, update: if signedIn() && userId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['groupId', 'addedAt']) &&
        request.resource.data.groupId == groupId &&
        groupMember(groupId);
    }
    match /groups/{groupId} {
      allow get: if signedIn();
      allow list, update, delete: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['name','ownerId','createdAt']) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 60;

      // Mini-games are scoped to permanent groups.
      match /games/{gameId} {
        function game() {
          return get(/databases/$(database)/documents/groups/$(groupId)/games/$(gameId)).data;
        }
        function gameAfter() {
          return getAfter(/databases/$(database)/documents/groups/$(groupId)/games/$(gameId)).data;
        }
        function isPlayer() {
          return groupMember(groupId) && request.auth.uid in game().playerIds;
        }
        allow get, list: if groupMember(groupId);
        allow create: if groupMember(groupId)
          && request.resource.data.keys().hasOnly([
            'type','ownerId','title','createdAt','updatedAt',
            'revealed','playerIds','readyIds','prompt'
          ])
          && request.resource.data.keys().hasAll([
            'type','ownerId','title','createdAt','updatedAt',
            'revealed','playerIds','readyIds','prompt'
          ])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.type in ['shifumi','bande','dessin']
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 40
          && request.resource.data.prompt is string
          && request.resource.data.prompt.size() <= 160
          && request.resource.data.revealed == false
          && request.resource.data.playerIds == [request.auth.uid]
          && request.resource.data.readyIds == [];
        allow update: if groupMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'playerIds','readyIds','revealed','updatedAt'
          ])
          && (
            // Join the second and final Shifumi slot.
            (resource.data.type == 'shifumi'
              && resource.data.playerIds.size() == 1
              && request.auth.uid != resource.data.playerIds[0]
              && request.resource.data.playerIds == [
                resource.data.playerIds[0],request.auth.uid
              ]
              && request.resource.data.readyIds == resource.data.readyIds
              && request.resource.data.revealed == resource.data.revealed)
            ||
            // Mark only your own already-submitted Shifumi move as ready.
            (resource.data.type == 'shifumi'
              && request.auth.uid in resource.data.playerIds
              && exists(/databases/$(database)/documents/groups/$(groupId)/games/$(gameId)/moves/$(request.auth.uid))
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.revealed == resource.data.revealed
              && request.resource.data.readyIds.size() <= 2
              && request.resource.data.readyIds.hasAll(resource.data.readyIds)
              && request.resource.data.readyIds.hasAll([request.auth.uid])
              && request.resource.data.readyIds.hasOnly(resource.data.playerIds))
            ||
            // Only the session creator can reveal a poll or drawing.
            (resource.data.type in ['bande','dessin']
              && resource.data.ownerId == request.auth.uid
              && resource.data.revealed == false
              && request.resource.data.revealed == true
              && request.resource.data.playerIds == resource.data.playerIds
              && request.resource.data.readyIds == resource.data.readyIds)
          );
        allow delete: if false;
        match /moves/{playerId} {
          allow get: if groupMember(groupId)
            && (request.auth.uid == playerId || game().readyIds.size() == 2);
          allow list: if groupMember(groupId) && game().readyIds.size() == 2;
          allow create: if isPlayer() && request.auth.uid == playerId
            && game().type == 'shifumi' && game().playerIds.size() == 2
            && request.resource.data.keys().hasOnly(['userId','choice','createdAt'])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.choice in ['rock','paper','scissors'];
          allow update, delete: if false;
        }
        match /answers/{answerId} {
          allow get: if groupMember(groupId)
            && (request.auth.uid == answerId || game().revealed == true);
          allow list: if groupMember(groupId) && game().revealed == true;
          allow create: if groupMember(groupId) && game().type == 'bande'
            && game().revealed == false && request.auth.uid == answerId
            && request.resource.data.keys().hasOnly(['userId','targetUid','createdAt'])
            && request.resource.data.userId == request.auth.uid
            && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.targetUid));
          allow update, delete: if false;
        }
        match /secret/{secretId} {
          allow get: if groupMember(groupId) &&
            (game().ownerId == request.auth.uid || game().revealed == true);
          allow list: if false;
          allow create: if groupMember(groupId)
            && secretId == 'word'
            && gameAfter().type == 'dessin'
            && gameAfter().ownerId == request.auth.uid
            && request.resource.data.keys().hasOnly(['word'])
            && request.resource.data.word is string
            && request.resource.data.word.size() > 0
            && request.resource.data.word.size() <= 35;
          allow update, delete: if false;
        }
        match /strokes/{strokeId} {
          allow get, list: if groupMember(groupId);
          allow create: if groupMember(groupId) && game().type == 'dessin'
            && game().ownerId == request.auth.uid && game().revealed == false
            && request.resource.data.keys().hasOnly(['userId','points','createdAt'])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.points is list
            && request.resource.data.points.size() > 0
            && request.resource.data.points.size() <= 100;
          allow delete: if groupMember(groupId) && game().ownerId == request.auth.uid
            && game().type == 'dessin' && game().revealed == false;
          allow update: if false;
        }
        match /guesses/{guessId} {
          allow get, list: if groupMember(groupId);
          allow create: if groupMember(groupId) && game().type == 'dessin'
            && game().revealed == false
            && game().ownerId != request.auth.uid
            && request.resource.data.keys().hasOnly(['userId','text','createdAt'])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 60;
          allow update, delete: if false;
        }
      }

      match /members/{memberId} {
        // A group invite URL contains an unguessable group id.
        allow get: if signedIn() && (memberId == request.auth.uid || groupMember(groupId));
        allow list: if groupMember(groupId);
        allow create: if signedIn() && memberId == request.auth.uid &&
          exists(/databases/$(database)/documents/groups/$(groupId)) &&
          request.resource.data.keys().hasOnly(['name', 'role', 'joinedAt']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() <= 100 &&
          request.resource.data.role == (
            get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
              ? 'owner' : 'member'
          );
        allow update, delete: if false;
      }
    }
    // Backwards-compatible access to the V1 "Mes événements" index.
    match /users/{userId}/events/{eventId} {
      allow get, list, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['eventId','role','addedAt']) &&
        request.resource.data.eventId == eventId &&
        request.resource.data.role in ['creator','participant'] &&
        exists(/databases/$(database)/documents/events/$(eventId));
    }
    match /events/{eventId} {
      allow get: if signedIn() && (
        !('groupId' in resource.data) || groupMember(resource.data.groupId)
      );
      allow list: if signedIn() &&
        ('groupId' in resource.data) &&
        groupMember(resource.data.groupId);
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 90 &&
        (
          (('groupId' in request.resource.data) &&
           groupMember(request.resource.data.groupId) &&
           request.resource.data.keys().hasOnly([
             'title','groupId','createdBy','startDate','endDate','status',
             'description','location','startTime','budget','confirmedDate','createdAt','updatedAt'
           ]) &&
           request.resource.data.status == 'planning' &&
           request.resource.data.confirmedDate == null)
          ||
          (!('groupId' in request.resource.data) &&
           request.resource.data.keys().hasOnly(['title','startDate','endDate','createdBy','createdAt']))
        );
      allow update: if eventCreator(eventId) &&
        ('groupId' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description','location','startTime','budget','confirmedDate','status','updatedAt'
        ]) &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 2000 &&
        request.resource.data.location is string &&
        request.resource.data.location.size() <= 250 &&
        request.resource.data.budget is string &&
        request.resource.data.budget.size() <= 35 &&
        request.resource.data.startTime is string &&
        request.resource.data.status in ['planning','confirmed'] &&
        (
          (request.resource.data.status == 'planning' && request.resource.data.confirmedDate == null)
          ||
          (request.resource.data.status == 'confirmed' &&
           request.resource.data.confirmedDate is string &&
           request.resource.data.confirmedDate >= resource.data.startDate &&
           request.resource.data.confirmedDate <= resource.data.endDate)
        );
      allow delete: if false;
      match /participants/{participantId} {
        allow read: if eventMember(eventId) || (
          signedIn() && !('groupId' in get(/databases/$(database)/documents/events/$(eventId)).data)
        );
        allow create, update: if signedIn() && participantId == request.auth.uid &&
          (
            eventMember(eventId) ||
            !('groupId' in get(/databases/$(database)/documents/events/$(eventId)).data)
          ) &&
          request.resource.data.keys().hasOnly(['name','availability','dates']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() <= 40 &&
          (
            (!('availability' in request.resource.data)) ||
            (request.resource.data.availability is map &&
             request.resource.data.availability.keys().size() <= 366)
          ) &&
          (
            (!('dates' in request.resource.data)) ||
            (request.resource.data.dates is list &&
             request.resource.data.dates.size() <= 366)
          );
        allow delete: if false;
      }
      match /activities/{activityId} {
        allow read: if eventMember(eventId);
        allow create: if eventCreator(eventId) &&
          request.resource.data.keys().hasOnly(['title','createdBy']) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 80;
        allow update, delete: if false;
      }
      match /votes/{voterId} {
        allow read: if eventMember(eventId);
        allow create, update: if eventMember(eventId) &&
          voterId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['activityIds','updatedAt']) &&
          request.resource.data.activityIds is list &&
          request.resource.data.activityIds.size() <= 50;
        allow delete: if false;
      }
    }
  }
}